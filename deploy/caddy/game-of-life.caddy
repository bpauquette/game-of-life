# React Game of Life routes. Owned by the game-of-life project.
{$CADDY_PROD_DOMAIN} {
	encode gzip
	header {
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none';"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	handle_path /api/* {
		uri strip_prefix /api
		reverse_proxy gol-backend:55000
	}
	@support path /support*
	handle @support { reverse_proxy gol-backend:55000 }
	handle { reverse_proxy gol-frontend:80 }
	log { output stdout
		format json }
	tls {$CADDY_EMAIL}
}

{$CADDY_TEST_DOMAIN} {
	encode gzip
	header {
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none';"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	handle_path /api/* {
		uri strip_prefix /api
		reverse_proxy gol-backend:55000
	}
	@support path /support*
	handle @support { reverse_proxy gol-backend:55000 }
	handle { reverse_proxy gol-frontend:80 }
	log { output stdout
		format json }
	tls {$CADDY_EMAIL}
}

localhost {
	encode gzip
	header {
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none';"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	handle_path /api/* {
		uri strip_prefix /api
		reverse_proxy gol-backend:55000
	}
	@support path /support*
	handle @support { reverse_proxy gol-backend:55000 }
	handle { reverse_proxy gol-frontend:80 }
	tls internal
}

react-blue.localhost {
	handle_path /api/* { uri strip_prefix /api
		reverse_proxy gol-backend-blue:55000 }
	@support path /support*
	handle @support { reverse_proxy gol-backend-blue:55000 }
	handle { reverse_proxy gol-frontend-blue:80 }
	tls internal
}
react-green.localhost {
	handle_path /api/* { uri strip_prefix /api
		reverse_proxy gol-backend-green:55000 }
	@support path /support*
	handle @support { reverse_proxy gol-backend-green:55000 }
	handle { reverse_proxy gol-frontend-green:80 }
	tls internal
}
backend-blue.localhost { reverse_proxy gol-backend-blue:55000
	tls internal }
backend-green.localhost { reverse_proxy gol-backend-green:55000
	tls internal }
